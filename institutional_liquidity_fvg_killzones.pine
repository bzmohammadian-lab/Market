//@version=5
indicator("Institutional Liquidity + FVG + Kill Zones (Stable)", overlay=true, max_boxes_count=500)

// =====================
// INPUTS
// =====================
pivotLen = input.int(5, "Swing Length")
eqThreshold = input.float(0.15, "Equal High/Low Threshold (%)") / 100
showFVG = input.bool(true, "Show FVG")
showKillZones = input.bool(true, "Show Kill Zones")
showLiquidity = input.bool(true, "Show Liquidity")

// =====================
// KILL ZONES
// =====================
hourUTC = hour(time, "UTC")

londonKill = hourUTC >= 7 and hourUTC < 10
nyKill     = hourUTC >= 13 and hourUTC < 16

bgcolor(showKillZones and londonKill ? color.new(color.purple, 90) : na)
bgcolor(showKillZones and nyKill ? color.new(color.orange, 90) : na)

// =====================
// SWINGS
// =====================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastHigh = na
var float prevHigh = na
var float lastLow  = na
var float prevLow  = na

if not na(ph)
    prevHigh := lastHigh
    lastHigh := ph

if not na(pl)
    prevLow := lastLow
    lastLow := pl

// =====================
// LIQUIDITY POOLS
// =====================
eqHigh = not na(lastHigh) and not na(prevHigh) and math.abs(lastHigh - prevHigh) / lastHigh < eqThreshold
eqLow  = not na(lastLow) and not na(prevLow) and math.abs(lastLow - prevLow) / lastLow < eqThreshold

liqHigh = eqHigh ? lastHigh : na
liqLow  = eqLow ? lastLow : na

plot(showLiquidity ? liqHigh : na, "Sell-side Liquidity", color=color.red, linewidth=2, style=plot.style_linebr)
plot(showLiquidity ? liqLow : na, "Buy-side Liquidity", color=color.green, linewidth=2, style=plot.style_linebr)

// =====================
// SWEEPS
// =====================
sweepHigh = not na(liqHigh) and high > liqHigh and close < liqHigh
sweepLow  = not na(liqLow) and low < liqLow and close > liqLow

// =====================
// BOS
// =====================
bosUp = not na(lastHigh) and close > lastHigh
bosDown = not na(lastLow) and close < lastLow

// =====================
// FVG
// =====================
bullFVG = low > high[2]
bearFVG = high < low[2]

// =====================
// FVG BOXES (FIXED: SINGLE LINE ONLY)
// =====================
if showFVG and bullFVG
    box.new(bar_index - 2, low, bar_index, high[2], bgcolor=color.new(color.green, 85), border_color=color.green)

if showFVG and bearFVG
    box.new(bar_index - 2, low[2], bar_index, high, bgcolor=color.new(color.red, 85), border_color=color.red)

// =====================
// SCORE
// =====================
score = 0
score += (eqHigh or eqLow) ? 1 : 0
score += (sweepHigh or sweepLow) ? 1 : 0
score += (bosUp or bosDown) ? 1 : 0
score += (londonKill or nyKill) ? 1 : 0
score += (bullFVG or bearFVG) ? 1 : 0

plot(score, "Score", color=color.white)

// =====================
// SETUPS
// =====================
bullSetup = sweepLow and bullFVG and bosUp and (londonKill or nyKill)
bearSetup = sweepHigh and bearFVG and bosDown and (londonKill or nyKill)

// =====================
// SIGNALS
// =====================
plotshape(bullSetup, location=location.belowbar, style=shape.labelup, color=color.lime, text="BULL")
plotshape(bearSetup, location=location.abovebar, style=shape.labeldown, color=color.red, text="BEAR")

alertcondition(bullSetup, "Bull Setup", "Bullish institutional spike")
alertcondition(bearSetup, "Bear Setup", "Bearish institutional spike")
